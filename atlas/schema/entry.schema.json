{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim Atlas entry",
  "type": "object",
  "required": ["slug", "title", "topic", "image", "sources", "claims", "status"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string" },
    "topic": { "enum": ["peptides", "hormones", "fat-loss", "sexual-health", "longevity", "supplements"] },
    "image": { "type": "string", "description": "Path to the infographic, relative to the site root" },
    "made_with": { "type": "string", "description": "Tool that produced the infographic, e.g. NotebookLM" },
    "sources": {
      "type": "array",
      "description": "Where the infographic's claims came from (the YouTube videos fed to NotebookLM)",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "channel": { "type": "string" }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "grade", "verdict", "note"],
        "properties": {
          "text": { "type": "string", "description": "The claim as the infographic states it" },
          "grade": { "enum": ["A", "B", "C", "D"], "description": "Strongest evidence that exists. See atlas/README.md" },
          "verdict": { "enum": ["holds", "overstated", "unsupported"] },
          "note": { "type": "string", "description": "One or two plain sentences on what the evidence actually shows" },
          "refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label"],
              "properties": { "label": { "type": "string" }, "url": { "type": "string" } }
            }
          }
        }
      }
    },
    "status": { "enum": ["draft", "verified"], "description": "draft until every ref has been read by a person" }
  }
}
